# voilot local dev environment
# Copy to .env and fill in your values: cp .env.example .env

# API keys for agent providers
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Paths
WORKSPACE_DIR=~/tmp/voilot-wd
DATA_DIR=~/tmp/voilot-wd/voilot-data

# Voice services (TTS + STT Docker containers)
TTS_URL=http://localhost:8880
STT_URL=http://localhost:5003

# Docker Compose project name (for voice containers)
VOILOT_COMPOSE_PROJECT=voilot
