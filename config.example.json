{
  "workspace": "/path/to/your/workspace",
  "defaultProvider": "opencode",
  "providers": {
    "opencode": {
      "type": "opencode",
      "binary": "opencode",
      "env": {
        "AWS_BEARER_TOKEN_BEDROCK": "${AWS_BEARER_TOKEN_BEDROCK}"
      }
    }
  },
  "maxInstances": 5,
  "idleTimeout": "10m",
  "ttsUrl": "http://localhost:8880",
  "sttUrl": "http://localhost:5003"
}
