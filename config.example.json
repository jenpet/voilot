{
  "workspace": "/path/to/your/workspace",
  "defaultProvider": "opencode",
  "providers": {
    "opencode": {
      "type": "opencode",
      "binary": "opencode",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "OPENROUTER_API_KEY": "sk-or-v1-your-key-here"
      }
    }
  },
  "maxInstances": 5,
  "idleTimeout": "10m",
  "ttsUrl": "http://localhost:8880",
  "sttUrl": "http://localhost:5003"
}
