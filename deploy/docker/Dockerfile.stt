# faster-whisper STT service
FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install faster-whisper and HTTP server
# requests is needed by faster-whisper but not always pulled transitively
RUN pip install --no-cache-dir \
    faster-whisper==1.1.1 \
    requests \
    flask==3.1.0 \
    gunicorn==23.0.0

# Create non-root user and model cache directory
RUN useradd -r -m -s /bin/false stt \
    && mkdir -p /home/stt/.cache/huggingface \
    && chown -R stt:stt /home/stt /app

ENV HF_HOME=/home/stt/.cache/huggingface

# Pre-download the base model (cached in image) as stt user
USER stt
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8')"

# Copy server script
COPY --chown=stt:stt deploy/docker/stt-server.py /app/server.py

ENV WHISPER_MODEL=base
ENV WHISPER_DEVICE=cpu
ENV WHISPER_COMPUTE_TYPE=int8
ENV STT_PORT=5003

EXPOSE 5003

CMD ["gunicorn", "--bind", "0.0.0.0:5003", "--timeout", "120", "--workers", "1", "server:app"]
