# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go module files first for caching
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy source code
COPY backend/ ./

# Build hash injection via ldflags
ARG BUILD_HASH=unknown
ARG BUILD_TIME=unknown

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${BUILD_HASH} -X main.buildTime=${BUILD_TIME}" \
    -o /voilot-server ./cmd/server

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates curl \
    && addgroup -S voilot && adduser -S voilot -G voilot

RUN mkdir -p /var/lib/voilot && chown voilot:voilot /var/lib/voilot

COPY --from=builder /voilot-server /usr/local/bin/voilot-server

USER voilot

EXPOSE 8080

ENTRYPOINT ["voilot-server"]
