# Build stage
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Copy go module files first for caching
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy source code
COPY backend/ ./

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /voilot-server ./cmd/server

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates

COPY --from=builder /voilot-server /usr/local/bin/voilot-server

EXPOSE 8080

ENTRYPOINT ["voilot-server"]
