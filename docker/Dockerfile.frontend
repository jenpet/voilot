# Build stage: generate static frontend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files for caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy source
COPY frontend/ ./

# In production, the frontend sits behind nginx which proxies /api/* and /ws/*
# to the backend. Set backendUrl to empty so relative URLs are used.
ENV NUXT_PUBLIC_BACKEND_URL=""

# Generate static site
RUN npx nuxt generate

# Runtime stage: serve with nginx
FROM nginx:1.27-alpine

# Install openssl for certificate generation
RUN apk add --no-cache openssl

# Generate CA certificate at build time (install this once on mobile devices).
# The server certificate is generated at container start by the entrypoint script,
# so it can include the current LAN IP as a SAN.
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 3650 \
      -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/ca.key \
      -out /etc/nginx/ssl/ca.crt \
      -subj "/CN=voilot CA/O=voilot-dev"

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config and shared snippets
RUN mkdir -p /etc/nginx/snippets
COPY docker/nginx.conf /etc/nginx/conf.d/voilot.conf
COPY docker/voilot-common.conf /etc/nginx/snippets/voilot-common.conf

# Copy entrypoint script (generates server cert + starts nginx)
COPY docker/voilot-entrypoint.sh /usr/local/bin/voilot-entrypoint.sh
RUN chmod +x /usr/local/bin/voilot-entrypoint.sh

# Copy built static files
COPY --from=builder /app/.output/public /usr/share/nginx/html

EXPOSE 80 443

ENTRYPOINT ["voilot-entrypoint.sh"]
